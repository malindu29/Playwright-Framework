{
  "name": "sauce-demo-playwright-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright JavaScript framework for Sauce Demo UI flows",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "auth": "playwright test tests/auth.setup.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
